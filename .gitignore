# Nunca se suben datos reales: nóminas, planillas con datos ni respaldos.
*.txt
datos/
respaldos/
*.json.bak
respaldo_*.json
bitacora_*.csv
maestro_*.csv

# Planillas: solo las plantillas vacías de assets/ van al repositorio.
*.xls
*.xlsx
*.xlsm
*.csv
!assets/*.xlsx

# Comprobantes y detalles de transferencias de BancoEstado (traen datos reales).
*.pdf

# Copia local de las reglas con los correos reales.
firestore/*.local.rules

# Herramientas de prueba
node_modules/
tests/node_modules/
firebase-debug.log
firestore-debug.log
ui-debug.log
.DS_Store

# Reglas generadas para el emulador
tests/.generado/
